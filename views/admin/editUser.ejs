<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= user ? 'Edit' : 'Create' %> User</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <header>
    <h2><%= user ? 'Edit' : 'Create' %> User</h2>
    <nav><a href="/admin/users">Back to users</a></nav>
    <hr>
  </header>
  <main>
    <% if (errors && errors.length) { %>
      <ul>
        <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
      </ul>
    <% } %>

    <form method="post" action="<%= user ? '/admin/users/' + user._id + '/edit' : '/admin/users/create' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Name: <input name="name" value="<%= user ? user.name : '' %>"></label><br>
      <label>Email: <input name="email" value="<%= user ? user.email : '' %>"></label><br>
      <label>Role:
        <select name="role">
          <option value="user" <%= user && user.role==='user' ? 'selected' : '' %>>User</option>
          <option value="admin" <%= user && user.role==='admin' ? 'selected' : '' %>>Admin</option>
        </select>
      </label><br>
      <label>Password: <input type="password" name="password" placeholder="<%= user ? 'leave blank to keep current' : '' %>"></label><br>
      <button type="submit"><%= user ? 'Save' : 'Create' %></button>
    </form>
  </main>
</body>
</html>
