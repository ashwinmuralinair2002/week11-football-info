<header class="site-header">
  <div class="container">
    <div class="brand">
      <a href="/">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          style="color:var(--accent-primary)">
          <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
          <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
          <line x1="12" y1="19" x2="12" y2="22"></line>
        </svg>
        ASH SPEAKS
      </a>
    </div>
    <nav class="main-nav">
      <% if (!currentUser) { %>
        <a href="/auth/login" class="btn"
          style="background: #facc15; color: #1e293b; padding: 0.5rem 1.25rem; border-radius: 9999px; font-weight: 600; margin-right: 0.5rem;">Log
          in</a>
        <a href="/auth/signup" class="btn btn-primary">Sign up</a>
        <% } else { %>
          <a href="/home" style="margin-right:8px;">Dashboard</a>
          <% if (currentUser.role==='admin' ) { %>
            <a href="/admin/football" style="margin-right:8px;">Manage Data</a>
            <a href="/admin/users" style="margin-right:16px;">Users</a>
            <% } %>
              <form method="post" action="/auth/logout" class="inline-form" style="display:inline; margin:0;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button class="btn btn-outline" type="submit">Log out</button>
              </form>
              <% } %>
    </nav>
  </div>
</header>